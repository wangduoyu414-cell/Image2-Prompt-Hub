      "operation": { "op": "set", "path": "/records/0/extensions/fixture.source_id", "value": "shadow" },
      "expect": "reject",
      "rule": "INV-009"
    },
    {
      "id": "adapter-forbidden-publication-decision",
      "gate": "GATE-002",
      "target": "adapter-output/g0dam-work-prompts.valid.json",
      "operation": { "op": "set", "path": "/records/0/publication_status", "value": "approved" },
      "expect": "reject",
      "rule": "INV-004/INV-010"
    },
    {
      "id": "adapter-dynamic-identity-field",
      "gate": "GATE-002",
