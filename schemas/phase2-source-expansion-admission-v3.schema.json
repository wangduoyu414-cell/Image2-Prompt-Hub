        "role": {"enum": ["full", "comparator", "excluded_control"]},
        "revision": {"$ref": "#/$defs/commit"},
        "mode": {"enum": ["continuous", "fixed_history", "reserve", "excluded"]},
        "status": {"enum": ["continuous_ready", "fixed_history_ready", "blocked", "comparator_only", "excluded"]},
        "identity": {"type": "object", "additionalProperties": false, "required": ["canonical_url", "provider_id", "default_branch", "fixed_revision"], "properties": {"canonical_url": {"type": "string", "format": "uri"}, "provider_id": {"enum": ["6a467d6d7239e0c7f8f23621", "1219036815", "1218575008", "1284712193"]}, "default_branch": {"const": "main"}, "fixed_revision": {"$ref": "#/$defs/commit"}}},
        "lineage": {"type": "object", "additionalProperties": false, "required": ["family_id", "canonical_source_id", "family_role"], "properties": {"family_id": {"type": "string", "minLength": 1}, "canonical_source_id": {"type": "string", "minLength": 1}, "family_role": {"enum": ["canonical", "aggregator", "reserve", "backup"]}}},
        "structure": {"type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {"strategy": {"type": "string", "minLength": 1}}},
        "rights": {"type": "object", "additionalProperties": false, "required": ["prompt_policy", "asset_policy", "auto_publish"], "properties": {"prompt_policy": {"const": "review_required"}, "asset_policy": {"const": "review_required"}, "auto_publish": {"const": false}}},
        "evidence": {"type": "object"},
        "fixed_core_digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {"if": {"properties": {"source_id": {"const": "goku-openlab-gpt-image-2-prompts-datasets"}}}, "then": {"properties": {"role": {"const": "full"}, "revision": {"const": "c4e79e9e11b3e754ec64f6400c7f94de6a5f103d"}, "mode": {"const": "continuous"}, "status": {"enum": ["continuous_ready", "blocked"]}, "evidence": {"$ref": "#/$defs/gokuEvidence"}}}},
        {"if": {"properties": {"source_id": {"const": "chaosrealmsai-gpt-image-2-gallery"}}}, "then": {"properties": {"role": {"const": "full"}, "revision": {"const": "5296db8c996e38776c83a0bc8c64f848dcd512b3"}, "mode": {"const": "fixed_history"}, "status": {"enum": ["fixed_history_ready", "blocked"]}, "evidence": {"$ref": "#/$defs/chaosEvidence"}}}},
        {"if": {"properties": {"source_id": {"const": "youmind-openlab-gpt-image-2-prompts-search"}}}, "then": {"properties": {"role": {"const": "comparator"}, "revision": {"const": "08861ab6db5d772e311f5661cfb0a3ae06e10bb1"}, "mode": {"const": "reserve"}, "status": {"const": "comparator_only"}, "evidence": {"$ref": "#/$defs/youmindEvidence"}}}},
        {"if": {"properties": {"source_id": {"const": "tigerowo-awesome-gpt-image-2-prompts"}}}, "then": {"properties": {"role": {"const": "excluded_control"}, "revision": {"const": "60e9c65baecfd6d6d51ac4e4d87f146af834bb64"}, "mode": {"const": "excluded"}, "status": {"const": "excluded"}, "evidence": {"$ref": "#/$defs/tigerEvidence"}}}}
      ]
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision", "mode", "case_scope", "structure_strategy", "family_role", "exclusions"],
      "properties": {
        "source_id": {"enum": ["goku-openlab-gpt-image-2-prompts-datasets", "chaosrealmsai-gpt-image-2-gallery"]},
        "revision": {"$ref": "#/$defs/commit"},
        "mode": {"enum": ["continuous", "fixed_history"]},
