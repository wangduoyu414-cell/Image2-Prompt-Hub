{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image2.local/schemas/fixed-history-admission-v1.schema.json",
  "title": "Fixed-history admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "revision",
    "mode",
    "structure_strategy",
    "family_role",
    "sync_eligible",
    "one_shot_import_only",
    "raw_case_count",
    "case_count",
    "excluded_case_count",
    "case_ledger_sha256",
    "exclusion_ledger_sha256",
    "source_report_path",
    "source_report_sha256",
    "source_report_canonical_digest",
    "adapter_ready_item_sha256",
    "output_variants",
    "admitted_case_ids",
    "exclusions"
  ],
  "properties": {
    "schema_version": { "const": "fixed-history-admission/v1" },
    "source_id": { "const": "chaosrealmsai-gpt-image-2-gallery" },
    "revision": { "$ref": "#/$defs/sha40" },
    "mode": { "const": "fixed_history" },
    "structure_strategy": { "const": "chaos_meta_three_webp_v1" },
    "family_role": { "const": "canonical" },
    "sync_eligible": { "const": false },
    "one_shot_import_only": { "const": true },
    "raw_case_count": { "const": 3798 },
    "case_count": { "const": 2460 },
    "excluded_case_count": { "const": 1338 },
    "case_ledger_sha256": { "const": "33484746656377578e62ad6f425d5d07f23cce0f9fdc5b04697fb31d402fa65b" },
    "exclusion_ledger_sha256": { "const": "8d3dccc3ff82053a7c580bfd56b69fd056858e804aa4fd8d7a608896af2f3eb5" },
    "source_report_path": { "const": "reports/phase2/source-expansion-admission-v3.json" },
    "source_report_sha256": { "$ref": "#/$defs/sha64" },
    "source_report_canonical_digest": { "const": "6fb4a72fea962d0c1d7a56d9400443c15bd5a1bbf5673ea6e14805ceac752833" },
    "adapter_ready_item_sha256": { "$ref": "#/$defs/sha64" },
    "output_variants": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/primary1600" },
        { "$ref": "#/$defs/secondary400" },
        { "$ref": "#/$defs/secondary2400" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "admitted_case_ids": {
      "type": "array",
      "minItems": 2460,
      "maxItems": 2460,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/caseId" }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1466,
      "maxItems": 1466,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "reason"],
        "properties": {
          "case_id": { "$ref": "#/$defs/caseId" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "caseId": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suffix", "filename", "role", "width"],
      "properties": {
        "suffix": { "type": "string" },
        "filename": { "type": "string" },
        "role": { "enum": ["output_primary", "output_secondary"] },
        "width": { "type": "integer" }
      }
    },
    "primary1600": {
      "allOf": [
        { "$ref": "#/$defs/variant" },
        { "properties": { "suffix": { "const": "01-primary-w1600" }, "filename": { "const": "image.w1600.webp" }, "role": { "const": "output_primary" }, "width": { "const": 1600 } } }
      ]
    },
    "secondary400": {
      "allOf": [
        { "$ref": "#/$defs/variant" },
        { "properties": { "suffix": { "const": "02-secondary-w400" }, "filename": { "const": "image.w400.webp" }, "role": { "const": "output_secondary" }, "width": { "const": 400 } } }
      ]
    },
    "secondary2400": {
      "allOf": [
        { "$ref": "#/$defs/variant" },
        { "properties": { "suffix": { "const": "03-secondary-w2400" }, "filename": { "const": "image.w2400.webp" }, "role": { "const": "output_secondary" }, "width": { "const": 2400 } } }
      ]
    }
  }
}
