        "raw_text": "{\n  \"type\": \"Web hero banner\",\n  \"goal\": \"为开源项目 Easy Dataset 生成 16:9 横版明色调宣传图，适合 GitHub README hero banner、官网首屏、公众号封面和技术分享首图\",\n  \"aspect_ratio\": \"16:9\",\n  \"layout\": {\n    \"left_column\": {\n      \"headline\": \"Easy Dataset\",\n      \"subhead\": \"一站式构建 LLM 微调、RAG 与评测数据集\",\n      \"slogan\": \"从文档到高质量数据集\",\n      \"badges\": [\"Fine-tuning\", \"RAG\", \"Eval\"]\n    },\n    \"right_column\": {\n      \"centerpiece\": \"明亮的 SaaS 工作台界面悬浮在浅色背景中，表现从多格式文档输入到高质量数据集输出的流程\",\n      \"input_cards\": [\"PDF\", \"Markdown\", \"DOCX\", \"TXT\", \"EPUB\"],\n      \"workspace_elements\": [\"数据表格\", \"QA 卡片\", \"切分面板\", \"评测分数卡\", \"导出面板\"],\n      \"output_cards\": [\"Fine-tuning Dataset\", \"RAG Knowledge Base\", \"Eval Benchmark\"],\n      \"scale\": \"占右侧 60%，使用柔和青绿色数据线串联输入、工作台与输出\"\n    },\n    \"bottom_feature_strip\": [\n      {\n        \"title\": \"文档解析\",\n        \"caption\": \"多格式输入\"\n      },\n      {\n        \"title\": \"智能切分\",\n        \"caption\": \"结构化处理\"\n      },\n      {\n        \"title\": \"问答生成\",\n        \"caption\": \"QA / 多轮 / COT\"\n      },\n      {\n        \"title\": \"图像 QA\",\n        \"caption\": \"视觉问答数据\"\n      },\n      {\n        \"title\": \"自动评测\",\n        \"caption\": \"Judge Model\"\n      },\n      {\n        \"title\": \"导出集成\",\n        \"caption\": \"JSONL / ShareGPT / LLaMA Factory\"\n      }\n    ]\n  },\n  \"background\": {\n    \"type\": \"暖白 #F8FAFC 与极淡青蓝 #EAF7F6 的明亮背景\",\n    \"decoration\": \"浅灰网格、柔和数据流线和轻微纸感颗粒，保持清爽留白\"\n  },\n  \"style\": {\n    \"aesthetic\": \"明亮、高级、开源 AI SaaS、干净的产品官网视觉\",\n    \"palette\": [\"#F8FAFC\", \"#EAF7F6\", \"#172033\", \"#14B8A6\", \"#F6B84B\", \"#6366F1\"],\n    \"typography\": \"现代无衬线，中文类似思源黑体，英文类似 Inter\",\n    \"lighting\": \"soft daylight, clean shadows, subtle cyan glow\"\n  },\n  \"footer\": {\n    \"items\": [\"github.com/ConardLi/easy-dataset\", \"Open Source\", \"AGPL-3.0\", \"14k+ Stars\"],\n    \"placement\": \"右下角或底部信息区，使用简洁开源徽章样式\"\n  },\n  \"constraints\": {\n    \"must_keep\": [\n      \"16:9 横版构图稳定\",\n      \"整体为明亮浅色调\",\n      \"Easy Dataset 标题大且清晰可读\",\n      \"Fine-tuning / RAG / Eval 三个使用场景醒目\",\n      \"从文档输入到数据集输出的视觉动线必须一眼可懂\",\n      \"文字必须正确、简洁、可读\"\n    ],\n    \"avoid\": [\n      \"深色赛博朋克背景\",\n      \"大面积紫色渐变\",\n      \"人物或机器人吉祥物\",\n      \"夸张 3D 卡通\",\n      \"代码雨\",\n      \"伪造真实产品截图\",\n      \"复杂长段落\",\n      \"二维码\",\n      \"第三方品牌 logo，除 GitHub 字样外不出现真实商标\",\n      \"拥挤表格或过密小字\"\n    ]\n  }\n}\n",
