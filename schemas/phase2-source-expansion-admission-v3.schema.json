    "gokuEvidence": {"allOf": [{"$ref": "#/$defs/fullBase"}, {"type": "object", "required": ["asset_classifications", "metadata_lfs_oid", "metadata_sha256"], "properties": {"authority": {"$ref": "#/$defs/hfAuthority"}, "maintenance": {"$ref": "#/$defs/continuousMaintenance"}}}]},
    "chaosEvidence": {"allOf": [{"$ref": "#/$defs/fullBase"}, {"type": "object", "properties": {"authority": {"$ref": "#/$defs/gitAuthority"}, "maintenance": {"$ref": "#/$defs/fixedHistoryMaintenance"}}}]},
