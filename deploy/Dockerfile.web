# syntax=docker/dockerfile:1.7
FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS dependencies
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM dependencies AS build
ARG IMAGE2_API_INTERNAL_BASE_URL=http://public-api:8000
ARG IMAGE2_ADMIN_API_BASE_URL=http://admin-api:8002
ARG IMAGE2_INTERNAL_PREVIEW_API_BASE_URL=http://127.0.0.1:8001
ENV NEXT_TELEMETRY_DISABLED=1 \
    IMAGE2_API_INTERNAL_BASE_URL=${IMAGE2_API_INTERNAL_BASE_URL} \
    IMAGE2_ADMIN_API_BASE_URL=${IMAGE2_ADMIN_API_BASE_URL} \
    IMAGE2_INTERNAL_PREVIEW_API_BASE_URL=${IMAGE2_INTERNAL_PREVIEW_API_BASE_URL}
COPY apps/web/ ./
RUN npm run build

FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]

