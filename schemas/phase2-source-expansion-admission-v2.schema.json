{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/phase2-source-expansion-admission-v2.schema.json",
  "title": "Phase 2 Source Expansion Admission v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "authority", "thresholds", "candidates", "adapter_ready_batch", "summary", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "phase2-source-expansion-admission-v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_audit_sha256", "source_registry_sha256", "phase2_discovery_v1_sha256", "inventory_contract_sha256", "phase2_activation_v1_sha256", "active_source_count", "current_case_count", "current_output_count", "current_source_file_count", "current_deduplicated_asset_object_count", "current_public_cases", "current_index_cache_key", "current_index_core_sha256"],
      "properties": {
        "source_audit_sha256": {"$ref": "#/$defs/sha256"},
        "source_registry_sha256": {"$ref": "#/$defs/sha256"},
        "phase2_discovery_v1_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_contract_sha256": {"$ref": "#/$defs/sha256"},
        "phase2_activation_v1_sha256": {"$ref": "#/$defs/sha256"},
        "active_source_count": {"const": 6},
        "current_case_count": {"const": 1513},
        "current_output_count": {"const": 1930},
        "current_source_file_count": {"const": 2260},
        "current_deduplicated_asset_object_count": {"const": 1885},
        "current_public_cases": {"const": 0},
        "current_index_cache_key": {"$ref": "#/$defs/sha256"},
        "current_index_core_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_unique_valid_cases", "minimum_pair_rate", "maximum_broken_asset_rate", "maximum_duplicate_rate", "latest_substantive_update_days", "minimum_substantive_update_dates_365"],
      "properties": {
        "minimum_unique_valid_cases": {"const": 50},
        "minimum_pair_rate": {"const": 0.9},
        "maximum_broken_asset_rate": {"const": 0.05},
        "maximum_duplicate_rate": {"const": 0.2},
        "latest_substantive_update_days": {"const": 180},
        "minimum_substantive_update_dates_365": {"const": 2}
      }
    },
    "candidates": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/candidate"}},
    "adapter_ready_batch": {"type": "array", "items": {"$ref": "#/$defs/batchItem"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "adapter_ready_count", "adapter_ready_unique_cases", "adapter_ready_unique_exact_contribution", "current_case_count", "current_output_count", "current_source_file_count", "current_deduplicated_asset_object_count", "real_public_cases", "protected_scope_modified"],
      "properties": {
        "candidate_count": {"const": 3},
        "adapter_ready_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "adapter_ready_unique_cases": {"type": "integer", "minimum": 0},
        "adapter_ready_unique_exact_contribution": {"type": "integer", "minimum": 0},
        "current_case_count": {"const": 1513},
        "current_output_count": {"const": 1930},
        "current_source_file_count": {"const": 2260},
        "current_deduplicated_asset_object_count": {"const": 1885},
        "real_public_cases": {"const": 0},
        "protected_scope_modified": {"const": false}
      }
    },
    "canonical_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "repositoryFileFact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "byte_size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "authority", "content_sha256", "byte_size", "media_type"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "authority": {"enum": ["fixed_local", "remote_observation"]},
        "content_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "byte_size": {"type": ["integer", "null"], "minimum": 1},
        "media_type": {"type": ["string", "null"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_record_id", "category", "source_path", "prompt_sha256", "prompt_length", "source_url_key", "input_assets", "outputs", "pairing_evidence", "risk_flags", "strong_pairing"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_length": {"type": "integer", "minimum": 1},
        "source_url_key": {"type": ["string", "null"]},
        "input_assets": {"type": "array", "items": {"$ref": "#/$defs/output"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
        "pairing_evidence": {"type": "string", "minLength": 1},
        "risk_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "strong_pairing": {"const": true}
      }
    },
    "remoteObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "url", "observed_at", "status", "media_type", "byte_size", "observed_bytes_sha256", "error"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://pbs\\.twimg\\.com/"},
        "observed_at": {"type": "string", "format": "date-time"},
        "status": {"type": ["integer", "null"]},
        "media_type": {"type": ["string", "null"]},
        "byte_size": {"type": ["integer", "null"], "minimum": 1},
        "observed_bytes_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "error": {"type": ["string", "null"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "result", "prompt_complete", "image_readable", "semantic_match", "visual_quality", "notes", "risk_flags"],
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "pass"}}, "required": ["result"]},
          "then": {"properties": {"prompt_complete": {"const": true}, "image_readable": {"const": true}, "semantic_match": {"const": true}, "visual_quality": {"enum": ["high", "acceptable"]}}}
        }
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail"]},
        "prompt_complete": {"type": "boolean"},
        "image_readable": {"type": "boolean"},
        "semantic_match": {"type": "boolean"},
        "visual_quality": {"enum": ["high", "acceptable", "low", "unknown"]},
        "notes": {"type": "string"},
        "risk_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "candidate_key", "identity", "lineage", "status", "status_reason", "recommended_adapter_strategy", "structure", "metrics", "maintenance", "rights", "quality", "contribution", "evidence", "fixed_core_digest"],
      "properties": {
        "source_id": {"$ref": "#/$defs/sourceId"},
        "candidate_key": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "identity": {
          "type": "object", "additionalProperties": false,
          "required": ["repository_id", "url", "default_branch", "fixed_commit_sha", "git_tree_sha", "tree_entry_count", "tree_manifest_sha256", "archived", "pushed_at"],
          "properties": {
            "repository_id": {"type": "integer", "minimum": 1},
            "url": {"type": "string", "pattern": "^https://github\\.com/"},
            "default_branch": {"type": "string", "minLength": 1},
            "fixed_commit_sha": {"$ref": "#/$defs/commitSha"},
            "git_tree_sha": {"$ref": "#/$defs/commitSha"},
            "tree_entry_count": {"type": "integer", "minimum": 1},
            "tree_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "archived": {"type": "boolean"},
            "pushed_at": {"type": "string", "format": "date-time"}
          }
        },
        "lineage": {
          "type": "object", "additionalProperties": false,
          "required": ["family_id", "family_role", "derived_from"],
          "properties": {
            "family_id": {"$ref": "#/$defs/sourceId"},
            "family_role": {"const": "canonical_repository"},
            "derived_from": {"type": "array", "maxItems": 0}
          }
        },
        "status": {"enum": ["adapter_ready", "probation", "blocked", "excluded"]},
        "status_reason": {"type": "string", "minLength": 1},
        "recommended_adapter_strategy": {"type": ["string", "null"]},
        "structure": {
          "type": "object", "additionalProperties": false,
          "required": ["record_source_path", "strategy", "local_asset_authority", "remote_asset_authority", "source_record_count"],
          "properties": {
            "record_source_path": {"type": "string", "minLength": 1},
            "strategy": {"type": "string", "minLength": 1},
            "local_asset_authority": {"type": "boolean"},
            "remote_asset_authority": {"const": false},
            "source_record_count": {"type": "integer", "minimum": 1}
          }
        },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["source_record_count", "observed_case_count", "exact_prompt_count", "output_reference_count", "local_output_reference_count", "remote_output_reference_count", "repository_raster_count", "orphan_raster_count", "broken_asset_count", "valid_case_count", "unique_valid_case_count", "pair_rate", "broken_asset_rate", "duplicate_count", "duplicate_rate", "within_source_dedupe_version"],
          "properties": {
            "source_record_count": {"type": "integer", "minimum": 1},
            "observed_case_count": {"type": "integer", "minimum": 1},
            "exact_prompt_count": {"type": "integer", "minimum": 1},
            "output_reference_count": {"type": "integer", "minimum": 1},
            "local_output_reference_count": {"type": "integer", "minimum": 0},
            "remote_output_reference_count": {"type": "integer", "minimum": 0},
            "repository_raster_count": {"type": "integer", "minimum": 0},
            "orphan_raster_count": {"type": "integer", "minimum": 0},
            "broken_asset_count": {"type": "integer", "minimum": 0},
            "valid_case_count": {"type": "integer", "minimum": 0},
            "unique_valid_case_count": {"type": "integer", "minimum": 0},
            "pair_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "broken_asset_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "duplicate_count": {"type": "integer", "minimum": 0},
            "duplicate_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "within_source_dedupe_version": {"const": "within-source-exact-v2-prompt-cross-record-url-image"}
          }
        },
        "maintenance": {
          "type": "object", "additionalProperties": false,
          "required": ["latest_substantive_update", "first_substantive_update", "substantive_update_dates_365", "substantive_dates_365", "substantive_dates", "evidence_commits", "evaluated_on", "latest_update_age_days", "maturity_span_days", "eligible"],
          "properties": {
            "latest_substantive_update": {"type": "string", "format": "date"},
            "first_substantive_update": {"type": "string", "format": "date"},
            "substantive_update_dates_365": {"type": "integer", "minimum": 0},
            "substantive_dates_365": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date"}},
            "substantive_dates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "date"}},
            "evidence_commits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commitSha"}},
            "evaluated_on": {"type": "string", "format": "date"},
            "latest_update_age_days": {"type": "integer", "minimum": 0},
            "maturity_span_days": {"type": "integer", "minimum": 0},
            "eligible": {"type": "boolean"}
          }
        },
        "rights": {
          "type": "object", "additionalProperties": false,
          "required": ["repository_license", "prompt_policy", "asset_policy", "public_eligibility", "auto_publish", "evidence_files", "provenance_summary"],
          "properties": {
            "repository_license": {"type": "string", "minLength": 1},
            "prompt_policy": {"const": "review_required"},
            "asset_policy": {"const": "review_required"},
            "public_eligibility": {"const": "review_required"},
            "auto_publish": {"const": false},
            "evidence_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repositoryFileFact"}},
            "provenance_summary": {"type": "string", "minLength": 1}
          }
        },
        "quality": {
          "type": "object", "additionalProperties": false,
          "required": ["result", "sample_size", "selection_method", "sample_ids", "sample_ids_sha256", "lint_version", "lint_flags", "coverage", "reviews", "finding"],
          "properties": {
            "result": {"enum": ["pass", "fail"]},
            "sample_size": {"type": "integer", "minimum": 1},
            "selection_method": {"type": "string", "minLength": 1},
            "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "sample_ids_sha256": {"$ref": "#/$defs/sha256"},
            "lint_version": {"const": "source-quality-lint-v2-risk-patterns-and-low-information"},
            "lint_flags": {"type": "object", "additionalProperties": {"type": "object", "required": ["count", "case_ids"], "properties": {"count": {"type": "integer", "minimum": 1}, "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
            "coverage": {
              "type": "object", "additionalProperties": false,
              "required": ["source_categories", "sampled_categories", "source_risk_flags", "sampled_risk_flags", "source_multi_output_case_count", "sampled_multi_output_case_count", "exact_overlap_sample_counts"],
              "properties": {
                "source_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                "sampled_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                "source_risk_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "sampled_risk_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "source_multi_output_case_count": {"type": "integer", "minimum": 0},
                "sampled_multi_output_case_count": {"type": "integer", "minimum": 0},
                "exact_overlap_sample_counts": {
                  "type": "object", "additionalProperties": false,
                  "required": ["image", "prompt", "source_url"],
                  "properties": {"image": {"type": "integer", "minimum": 0}, "prompt": {"type": "integer", "minimum": 0}, "source_url": {"type": "integer", "minimum": 0}}
                }
              }
            },
            "reviews": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review"}},
            "finding": {"type": "string", "minLength": 1}
          }
        },
        "contribution": {
          "type": "object", "additionalProperties": false,
          "required": ["normalization_version", "current_source_url_overlap_count", "current_source_url_overlap_case_ids", "current_prompt_overlap_count", "current_prompt_overlap_case_ids", "current_image_overlap_count", "current_image_overlap_case_ids", "unique_exact_contribution_count", "unique_exact_contribution_case_ids_sha256"],
          "properties": {
            "normalization_version": {"const": "exact-overlap-v1-nfkc-casefold-whitespace"},
            "current_source_url_overlap_count": {"type": "integer", "minimum": 0},
            "current_source_url_overlap_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "current_prompt_overlap_count": {"type": "integer", "minimum": 0},
            "current_prompt_overlap_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "current_image_overlap_count": {"type": "integer", "minimum": 0},
            "current_image_overlap_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "unique_exact_contribution_count": {"type": "integer", "minimum": 0},
            "unique_exact_contribution_case_ids_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["case_ledger", "case_ledger_sha256", "orphan_assets", "orphan_assets_sha256", "auxiliary_assets", "asset_terminal_results", "asset_terminal_results_sha256", "remote_observations", "remote_observations_sha256"],
          "properties": {
            "case_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
            "case_ledger_sha256": {"$ref": "#/$defs/sha256"},
            "orphan_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "orphan_assets_sha256": {"$ref": "#/$defs/sha256"},
            "auxiliary_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "asset_terminal_results": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/output"}},
            "asset_terminal_results_sha256": {"$ref": "#/$defs/sha256"},
            "remote_observations": {"type": "array", "items": {"$ref": "#/$defs/remoteObservation"}},
            "remote_observations_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "fixed_core_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "batchItem": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "source_id", "fixed_commit_sha", "unique_valid_case_count", "unique_exact_contribution_count", "recommended_adapter_strategy", "case_scope", "known_exclusions", "public_eligibility"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "source_id": {"$ref": "#/$defs/sourceId"},
        "fixed_commit_sha": {"$ref": "#/$defs/commitSha"},
        "unique_valid_case_count": {"type": "integer", "minimum": 1},
        "unique_exact_contribution_count": {"type": "integer", "minimum": 1},
        "recommended_adapter_strategy": {"type": "string", "minLength": 1},
        "case_scope": {
          "type": "object", "additionalProperties": false,
          "required": ["source_record_count", "observed_case_count", "output_reference_count"],
          "properties": {
            "source_record_count": {"type": "integer", "minimum": 1},
            "observed_case_count": {"type": "integer", "minimum": 1},
            "output_reference_count": {"type": "integer", "minimum": 1}
          }
        },
        "known_exclusions": {
          "type": "object", "additionalProperties": false,
          "required": ["orphan_assets", "quality_failed_case_ids"],
          "properties": {
            "orphan_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "quality_failed_case_ids": {"type": "array", "maxItems": 0}
          }
        },
        "public_eligibility": {"const": "review_required"}
      }
    }
  }
}
