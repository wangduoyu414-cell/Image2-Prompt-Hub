# Copy outside the repository and replace every replace-* value before startup.
IMAGE2_IMAGE_TAG=local
IMAGE2_SITE_ADDRESS=image2.example.com
IMAGE2_PUBLIC_ORIGIN=https://image2.example.com
IMAGE2_TLS_EMAIL=ops@example.com
IMAGE2_ENVIRONMENT=production
IMAGE2_RELEASE=replace-with-git-sha-or-image-tag
IMAGE2_HTTP_PORT=80
IMAGE2_HTTPS_PORT=443

IMAGE2_POSTGRES_DB=image2
IMAGE2_POSTGRES_USER=image2
IMAGE2_POSTGRES_PASSWORD=replace-with-url-safe-random-password
IMAGE2_DATABASE_URL=postgresql://image2:replace-with-url-safe-random-password@postgres:5432/image2

# Production requires an external private HTTPS S3-compatible endpoint (S3/R2).
IMAGE2_S3_ENDPOINT_URL=https://replace-with-private-s3-endpoint.example.com
IMAGE2_S3_BUCKET=image2-private
IMAGE2_S3_REGION=auto
IMAGE2_S3_ACCESS_KEY_ID=replace-with-private-access-key
IMAGE2_S3_SECRET_ACCESS_KEY=replace-with-private-secret-key

# Generate hashes with: python -m apps.admin_api hash-password
IMAGE2_ADMIN_USERS_JSON={"admin":{"role":"admin","password_hash":"replace-with-generated-scrypt-hash"}}
IMAGE2_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Queue cadence checks every five minutes; per-source cadence lives in sources-v2.yaml.
SYNC_INTERVAL_SECONDS=300
SYNC_JITTER_SECONDS=60
SYNC_MESSAGE_STALE_SECONDS=18000
MONITOR_INTERVAL_SECONDS=300
MONITOR_SYNC_STALE_SECONDS=28800

# Optional external observability. Leave blank to disable without runtime failure.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
IMAGE2_ALERT_WEBHOOK_URL=
OTEL_CONSOLE_EXPORTER=false
