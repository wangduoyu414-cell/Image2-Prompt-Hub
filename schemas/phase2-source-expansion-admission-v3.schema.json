    "youmindEvidence": {"type": "object", "additionalProperties": false, "required": ["case_ledger", "asset_ledger", "orphan_ledger", "exclusion_ledger", "comparator_ledger"], "properties": {"case_ledger": {"type": "array", "maxItems": 0}, "asset_ledger": {"type": "array", "maxItems": 0}, "orphan_ledger": {"type": "array", "maxItems": 0}, "exclusion_ledger": {"type": "array", "maxItems": 0}, "comparator_ledger": {"$ref": "#/$defs/youmindComparator"}}},
    "tigerControl": {"type": "object", "additionalProperties": false, "required": ["record_count", "image_count", "missing_fields", "readme_backup_claim", "family_mapping", "authority"], "properties": {"record_count": {"type": "integer", "minimum": 1}, "image_count": {"type": "integer", "minimum": 0}, "missing_fields": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "readme_backup_claim": {"const": true}, "family_mapping": {"const": "blocked"}, "authority": {"$ref": "#/$defs/gitAuthority"}}},
    "tigerEvidence": {"type": "object", "additionalProperties": false, "required": ["case_ledger", "asset_ledger", "orphan_ledger", "exclusion_ledger", "control_record"], "properties": {"case_ledger": {"type": "array", "maxItems": 0}, "asset_ledger": {"type": "array", "maxItems": 0}, "orphan_ledger": {"type": "array", "maxItems": 0}, "exclusion_ledger": {"type": "array", "maxItems": 0}, "control_record": {"$ref": "#/$defs/tigerControl"}}},
