    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "pair_rate", "broken_authoritative_asset_count", "broken_authoritative_asset_rate", "within_source_duplicate_rate", "exclusion_reason_counts", "raw_case_count", "filtered_case_count", "asset_count", "orphan_asset_count", "excluded_case_count", "exclusion_count", "case_ledger_sha256", "asset_ledger_sha256", "orphan_ledger_sha256", "exclusion_ledger_sha256", "lint_version"],
