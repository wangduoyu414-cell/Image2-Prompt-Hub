      "properties": {
        "kind": {"const": "hf"},
        "repository": {"const": "Goku-OpenLab/gpt-image-2-prompts-datasets"},
        "revision": {"const": "c4e79e9e11b3e754ec64f6400c7f94de6a5f103d"},
        "file_count": {"const": 28296},
        "image_count": {"const": 28293},
        "lfs_count": {"const": 28294},
        "metadata_oid": {"const": "45295247269b84b54b053007c36682d3fc344599d69e0f18fedfb0b3088d281f"},
        "metadata_size": {"const": 116859730},
        "tree_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
