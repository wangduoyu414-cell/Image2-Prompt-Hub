{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image2.local/schemas/content-quality-v1.schema.json",
  "title": "Content Quality Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "scope", "decisions"],
  "properties": {
    "schema_version": {"const": "content-quality-ledger/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "normalization", "reviewed_exact_prompt_group_count", "reviewed_source_case_count", "reviewed_output_reference_count"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "normalization": {"type": "string", "minLength": 1},
        "reviewed_exact_prompt_group_count": {"type": "integer", "minimum": 1},
        "reviewed_source_case_count": {"type": "integer", "minimum": 1},
        "reviewed_output_reference_count": {"type": "integer", "minimum": 1}
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "revision_sha", "source_case_key", "prompt_sha256", "output_content_sha256", "verdict", "reason_code", "review_method", "review_note"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "revision_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_case_key": {"type": "string", "minLength": 1},
          "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output_content_sha256": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "verdict": {"enum": ["blocked", "duplicate_only"]},
          "reason_code": {"enum": ["non_result_capture", "prompt_output_mismatch", "near_identical_cross_source_render", "exact_prompt_output_subset"]},
          "review_method": {"const": "manual_visual_exact_prompt_group_v1"},
          "review_note": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
