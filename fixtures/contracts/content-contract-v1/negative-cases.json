{
  "schema_version": "content-contract-negative-cases/v1",
  "description": "Deterministic in-memory mutations. These are contract tests, not source-derived pilot facts and do not add upstream Prompt or image content.",
  "cases": [
    {
      "id": "generation-empty-prompt",
      "gate": "GATE-001",
      "target": "generation-example/g0dam-work-prompts.valid.json",
      "operation": { "op": "set", "path": "/prompts/0/raw_text", "value": "" },
      "expect": "reject",
      "rule": "INV-001/RULE-004"
    },
    {
      "id": "generation-no-output",
      "gate": "GATE-001",
      "target": "generation-example/g0dam-work-prompts.valid.json",
      "operation": { "op": "set", "path": "/generation_examples/0/output_asset_ids", "value": [] },
      "expect": "reject",
      "rule": "INV-002"
    },
    {
      "id": "generation-dangling-prompt-reference",
      "gate": "GATE-001",
      "target": "generation-example/g0dam-work-prompts.valid.json",
      "operation": { "op": "set", "path": "/generation_examples/0/prompt_id", "value": "prompt:missing" },
      "expect": "reject",
      "rule": "INV-005"
    },
    {
      "id": "generation-final-asset-without-hash",
      "gate": "GATE-001",
      "target": "generation-example/g0dam-work-prompts.valid.json",
      "operation": { "op": "delete", "path": "/assets/0/content_sha256" },
      "expect": "reject",
      "rule": "INV-005/RULE-005"
    },
    {
      "id": "generation-inferred-pairing-promoted",
      "gate": "GATE-001",
      "target": "generation-example/g0dam-work-prompts.valid.json",
      "operation": { "op": "set", "path": "/generation_examples/0/pairing/method", "value": "inferred_local_order" },
      "expect": "reject",
      "rule": "INV-006"
    },
    {
      "id": "generation-guessed-model",
      "gate": "GATE-001",
      "target": "generation-example/g0dam-work-prompts.valid.json",
      "operation": { "op": "set", "path": "/generation_examples/0/generation_claim/model_raw", "value": "guessed-from-repository-name" },
      "expect": "reject",
      "rule": "INV-003/RULE-006"
    },
    {
