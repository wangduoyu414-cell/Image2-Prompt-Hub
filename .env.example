# Copy this only into an external runtime directory; never place real credentials in the workspace.
INVENTORY_POSTGRES_DB=inventory_test
INVENTORY_POSTGRES_USER=inventory_user
INVENTORY_POSTGRES_PASSWORD=replace-with-random-runtime-secret
INVENTORY_POSTGRES_PORT=15432
INVENTORY_S3_ACCESS_KEY=replace-with-random-runtime-key
INVENTORY_S3_SECRET_KEY=replace-with-random-runtime-secret
INVENTORY_S3_PORT=19000
INVENTORY_DATABASE_URL=postgresql://inventory_user:replace-with-random-runtime-secret@127.0.0.1:15432/inventory_test
INVENTORY_S3_ENDPOINT_URL=http://127.0.0.1:19000
INVENTORY_S3_BUCKET=inventory-private-test
INVENTORY_S3_REGION=us-east-1

# Local-only, review-required real-case preview. Keep cache/runtime state outside the workspace.
IMAGE2_INTERNAL_PREVIEW_DATA_ROOT=C:\Users\admin\.codex\runtime\image2\source-git-v1
IMAGE2_INTERNAL_PREVIEW_CACHE_ROOT=C:\Users\admin\.codex\runtime\image2\internal-preview
IMAGE2_INTERNAL_PREVIEW_API_BASE_URL=http://127.0.0.1:8001

# Authenticated review administration. Generate password hashes with:
# py -3.12 -m apps.admin_api hash-password
IMAGE2_ADMIN_USERS_JSON={"reviewer":{"role":"reviewer","password_hash":"replace-with-generated-scrypt-hash"}}
IMAGE2_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
IMAGE2_ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
IMAGE2_ADMIN_SECURE_COOKIES=false
IMAGE2_ADMIN_SOURCE_AUDIT=D:\image2\reports\source-audit-v2.json
IMAGE2_ADMIN_API_BASE_URL=http://127.0.0.1:8002

# Public API/Web use the independent Publication v2 current. v1 routes remain available for compatibility.
IMAGE2_PUBLIC_API_VERSION=v2
