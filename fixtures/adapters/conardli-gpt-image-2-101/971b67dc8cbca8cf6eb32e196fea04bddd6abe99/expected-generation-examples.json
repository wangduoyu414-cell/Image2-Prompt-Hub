        "prompt_id": "prompt:sha256:09a3d781b65ecb4618ddaca62fcd096a8cb56fb4a1983bda1453e43d86922298",
        "raw_text": "{\n  \"type\": \"Qualitative Comparison Grid（论文级多方法多样本对比网格）\",\n  \"goal\": \"生成一张可直接放进论文 qualitative results 章节的文生图对比网格，严格对齐、Ours 列深红细边框、英文列首\",\n  \"canvas\": {\n    \"aspect_ratio\": \"4:3\",\n    \"background\": \"white #FFFFFF\",\n    \"outer_padding\": \"40px\"\n  },\n  \"grid\": {\n    \"rows\": \"4\",\n    \"cols\": \"5\",\n    \"cell_size_rule\": \"all cells identical size; gap between cells 4-6px\",\n    \"cell_aspect\": \"square\"\n  },\n  \"headers\": {\n    \"column_headers\": {\n      \"enabled\": true,\n      \"items\": [\n        {\n          \"id\": \"C1\",\n          \"label\": \"Text Prompt\"\n        },\n        {\n          \"id\": \"C2\",\n          \"label\": \"DALL·E 3 [1]\"\n        },\n        {\n          \"id\": \"C3\",\n          \"label\": \"Midjourney v6 [2]\"\n        },\n        {\n          \"id\": \"C4\",\n          \"label\": \"SDXL 1.0 [3]\"\n        },\n        {\n          \"id\": \"C5\",\n          \"label\": \"Ours (proposed)\",\n          \"highlight\": true\n        }\n      ],\n      \"style\": \"centered above each column, sans-serif bold 11pt, citations in [brackets]\"\n    },\n    \"row_labels\": {\n      \"enabled\": true,\n      \"items\": [\n        \"Prompt A: “a photorealistic red fox in snow, 85mm, shallow DoF”\",\n        \"Prompt B: “futuristic Tokyo alley at night, neon, rain, cinematic”\",\n        \"Prompt C: “ceramic mug on oak table, morning window light, product shot”\",\n        \"Prompt D: “watercolor botanical illustration, eucalyptus leaves, white background”\"\n      ],\n      \"style\": \"left margin, 10pt compact sans, two lines max per label\"\n    }\n  },\n  \"cell_content\": {\n    \"type\": \"rgb_image\",\n    \"options_explained\": {\n      \"note\": \"Col1: monospace text box rendering the prompt; Col2–5: model outputs for that row's prompt\"\n    },\n    \"consistency_rule\": \"each row shows the same prompt in column 1 and all generated images reflect that text only\"\n  },\n  \"highlights\": {\n    \"ours_column\": {\n      \"enabled\": true,\n      \"style\": \"thicker border 1.5px in deep red #DC2626 around each Ours cell\"\n    },\n    \"zoom_in_boxes\": {\n      \"enabled\": \"false\",\n      \"rule\": \"N/A\"\n    }\n  },\n  \"caption\": {\n    \"enabled\": true,\n    \"label\": \"Figure 5.\",\n    \"text\": \"Qualitative text-to-image comparison on fixed prompts. Our method (last column) better preserves specular highlights and text–image alignment; see supp. for more seeds.\",\n    \"style\": \"below the grid, italic smaller sans, justified\"\n  },\n  \"constraints\": {\n    \"must_keep\": [\n      \"Ours column clearly outlined\",\n      \"same semantic scene per row across methods\",\n      \"no decorative gradients in grid background\"\n    ],\n    \"avoid\": [\n      \"mismatched row content\",\n      \"unreadable prompt text in column 1\"\n    ]\n  }\n}\n",
