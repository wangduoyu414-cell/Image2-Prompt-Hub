      "rule": "REQ-005/RISK-007"
    },
    {
      "id": "adapter-partial-failure-accounting",
      "gate": "GATE-002",
      "target": "adapter-output/g0dam-work-prompts.valid.json",
      "operation": { "op": "append_controlled_parse_error" },
      "expect": "accept",
      "rule": "SCN-004/RULE-008",
      "control_only": true
    },
    {
      "id": "assembly-unresolved-asset-directly-used",
      "gate": "GATE-003",
      "target": "assembly",
      "operation": { "op": "project_without_resolution" },
      "expect": "reject",
      "rule": "REQ-003/SCN-005"
    },
    {
      "id": "assembly-parse-error-leakage",
      "gate": "GATE-003",
      "target": "assembly",
      "operation": { "op": "project_quarantined_case" },
      "expect": "reject",
      "rule": "RULE-008/ASSEMBLY-001"
    }
