      "expect": "reject",
      "rule": "INV-007/RULE-001"
    },
    {
      "id": "adapter-ambiguous-promoted-to-strong",
      "gate": "GATE-002",
      "target": "adapter-output/g0dam-work-prompts.valid.json",
      "operation": { "op": "set", "path": "/records/0/pairings/0/method", "value": "ambiguous" },
      "expect": "reject",
      "rule": "INV-006"
    },
    {
